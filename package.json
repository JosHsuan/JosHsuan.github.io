{
  "name": "joshsuan-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": "24.x", "pnpm": "11.19.0" },
  "scripts": {
    "dev": "pnpm content:export && next dev --webpack --hostname 127.0.0.1",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:export": "tsx scripts/export-content.ts",
    "motion:validate": "tsx scripts/validate-motion.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "build": "pnpm content:export && pnpm motion:validate && next build --webpack && pnpm audit:build",
    "audit:build": "tsx scripts/audit-build.ts",
    "preview": "tsx scripts/serve-export.ts",
    "test:e2e": "playwright test",
    "check": "pnpm content:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@theatre/core": "0.7.2",
    "gsap": "3.15.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@theatre/studio": "0.7.2",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
